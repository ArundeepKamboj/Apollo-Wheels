# Copy to config/local.env and edit values for your machine. No secrets in this file.
HOST=127.0.0.1
FRONTEND_PORT=5173
API_GATEWAY_PORT=8000
API_GATEWAY_URL=http://127.0.0.1:8000
CONTRACT_API_PORT=8001
PRICING_API_PORT=8002
BILLING_API_PORT=8003
AUTH_API_PORT=8004
APOLLO_DB_PATH=data/apollo_wheels.db
APOLLO_DOCUMENT_DIR=data/documents
CONTRACT_API_URL=http://127.0.0.1:8001
PRICING_API_URL=http://127.0.0.1:8002
BILLING_API_URL=http://127.0.0.1:8003
AUTH_API_URL=http://127.0.0.1:8004
# Keep synthetic for a no-download demo. Set to ollama after installing Ollama and pulling this candidate.
LLM_PROVIDER=synthetic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
# Local demo only. Change these values before sharing the environment.
AUTH_JWT_SECRET=apollo-local-demo-only-signing-key-change-before-sharing
AUTH_ACCOUNTS_FILE=config/demo_accounts.json
AUTH_PROVIDER=local
AUTH_LOCAL_DEMO_ENABLED=true
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_PRICING_SERVICE_SECRET=pricing-demo-secret
AUTH_BILLING_SERVICE_SECRET=billing-demo-secret
